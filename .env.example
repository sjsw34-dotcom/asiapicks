# --- Affiliate tracking IDs (public IDs, read at build time; empty = plain non-affiliate links) ---
# Viator Partner Program: pid looks like P00123456, mcid is a number
VIATOR_PID=
VIATOR_MCID=
# Creatrip Affiliate: the code after "AFF-" in ?utm_source=AFF-xxxx
CREATRIP_AFF_CODE=
# Trip.com Affiliate: Allianceid and SID from the Link Builder
TRIPCOM_ALLIANCE_ID=
TRIPCOM_SID=

# --- Images ---
OPENAI_API_KEY=
# data.go.kr service key for the KTO tourism photo API (관광사진 정보)
KTO_PHOTO_API_KEY=

# --- Bing IndexNow ---
INDEXNOW_KEY=
